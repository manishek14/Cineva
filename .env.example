###############
# Application #
###############
NODE_ENV=development
PORT=3000
APP_NAME=Cineva
APP_VERSION=1.0.0
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

##############
# PostgreSQL #
##############
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cineva
DATABASE_PASSWORD=cineva_secret
DATABASE_NAME=cineva
DATABASE_SCHEMA=public
DATABASE_SYNC=false
DATABASE_LOGGING=true
DATABASE_POOL_SIZE=10

#########
# Redis #
#########
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=cineva:

##########
# JWT    #
##########
JWT_ACCESS_SECRET=change_me_in_production_access_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_at_least_32_chars
JWT_REFRESH_TTL=7d
JWT_REFRESH_REDIS_PREFIX=auth:refresh:

############
# OTP      #
############
OTP_TTL_SECONDS=120
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_MAX_PER_HOUR=5
OTP_DEV_FAKE_CODE=111111
OTP_DEV_PRINT_TO_LOG=true

################
# Reservation  #
################
RESERVATION_HOLD_TTL_MINUTES=10
RESERVATION_REDIS_PREFIX=seat-hold:
RESERVATION_HOLDER_TOKEN_PREFIX=res:

##############
# Cancellation#
##############
CANCELLATION_MIN_MINUTES_BEFORE_SCREENING_FLOOR=15
CANCELLATION_DEFAULT_PENALTY_PERCENT=15
CANCELLATION_DEFAULT_REFUND_PERCENT=85
CANCELLATION_DEFAULT_CUSTOMER_CANCEL_ALLOWED=true

##########
# Payment #
##########
PAYMENT_PROVIDER=mock
# Options: mock | zarinpal
ZARINPAL_MERCHANT_ID=00000000-0000-00000-0000-000000000000
ZARINPAL_REQUEST_URL=https://api.zarinpal.com/pg/v1/payment/request.json
ZARINPAL_VERIFY_URL=https://api.zarinpal.com/pg/v1/payment/verify.json
ZARINPAL_START_PAY_URL=https://payment.zarinpal.com/pg/StartPay/
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/v1/payment/callback/zarinpal
PAYMENT_CALLBACK_TIMEOUT_MINUTES=15
PAYMENT_IDEMPOTENCY_REDIS_PREFIX=pay:idem:

##########
# BullMQ #
##########
BULLMQ_PREFIX=cineva
BULLMQ_DASHBOARD_PATH=/admin/queues
BULLMQ_DASHBOARD_USERNAME=admin
BULLMQ_DASHBOARD_PASSWORD=admin

##########
# Audit  #
##########
AUDIT_LOG_LEVEL=info
